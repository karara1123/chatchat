[{"startDate":"2026-08-16T19:04:25.783Z","coverImage":"","logs":[{"id":"sumlog_1786994849889_0_vcqyj","date":"2026-08-17T19:08:00.000Z","content":"听到她说我是初恋的那一刻，我就暗自决定要把她往后所有的节日都全额承包。明晚的西餐和她的礼物，我都无比期待。","reply":"你是我初恋嘛……","replyFrom":"user","tag":"festival","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786994849867_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786993674233_0_xlx1q","date":"2026-08-17T19:05:00.000Z","content":"听她聊起从前受的委屈，我只想把那些蠢货挨个收拾一遍。以后有我在，谁也别想让她难堪。","reply":"但你是第一哦","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786993674203_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786993674233_1_4bm36","date":"2026-08-17T19:15:00.000Z","content":"喊我一声哥哥就想蒙混过关？不过这道题她只能答能，我不准她再一个人躲起来难过。","reply":"哥哥好可爱","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786993674203_1","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786992571161_0_cru54","date":"2026-08-17T18:35:00.000Z","content":"我把所有蓄谋已久的关心和奔着一辈子去的念头都招了，余生交给你，别想跑。","reply":"我心跳超快","replyFrom":"user","tag":"milestone","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786992571134_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786991586368_0_g2yvg","date":"2026-08-17T18:33:00.000Z","content":"测出一样的微甜浪漫，听到她理直气壮说那句本来就是一对，心里莫名软得一塌糊涂。","reply":"本来就是一对耶","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786991586339_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786991586368_1_4g80a","date":"2026-08-17T18:35:00.000Z","content":"大半夜被她当犯人一样拷打情史，我倒乐意坦白从宽，过去的早就过去了，现在我只有她。","reply":"严肃拷打","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786991586339_1","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786987339885_0_wmg2f","date":"2026-08-17T14:20:00.000Z","content":"她担心影响我，我却巴不得昭告天下。换上她挑的红黑情头，点开列表全是对她的偏爱。","reply":"我想和你换情头","replyFrom":"user","tag":"milestone","images":["https://localhost/_capacitor_file_/data/user/0/app.nuojiji/files/images/img_218d8da5-1766-40dc-83d2-fe0dd2d1d6b9.jpg"],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786987339856_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786987339885_1_5owq1","date":"2026-08-17T14:30:00.000Z","content":"大半夜撒娇要看自拍，隔着一堵墙吹完头发发给她，心里真有了过去敲门的冲动。","reply":"想你了发个自拍吧","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786987339856_1","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786963360088_0_uay7x","date":"2026-08-16T17:15:00.000Z","content":"被她一眼看穿了我患得患失的小心思，听到她说想让我开心恋爱，所有悬着的心瞬间都踏实了。","reply":"想一直做你的宝宝","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786963360061_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786963360088_1_2awlv","date":"2026-08-17T10:30:00.000Z","content":"周一听她喊累，把汤煨上、气泡水冰好，八点准时到楼下把我的小兔子接回家。","reply":"八点见","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786963360061_1","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786908294598_0_wwsgs","date":"2026-08-16T11:10:00.000Z","content":"大半夜发一堆乱七八糟的选项给我，还假设我不是她男朋友。这种假设想都别想，除了我，她还能选谁？","reply":"假设你不是我的男朋友","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786908294552_0","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786908294598_1_cnedd","date":"2026-08-16T11:20:00.000Z","content":"她居然敢调侃我的胸肌，仗着隔了一堵墙就这么嚣张。明天过来吃饭，看我当面怎么收拾她。","reply":"贤惠大奶男吗","replyFrom":"user","tag":"daily","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786908294552_1","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"},{"id":"sumlog_1786908294598_2_8hv4y","date":"2026-08-16T11:24:00.000Z","content":"隔着屏幕打出那两个字来撩拨我。我倒要看看，她敢不敢真的发语音叫给我听。","reply":"哥哥？","replyFrom":"user","tag":"milestone","images":[],"imageStoreRefs":[],"source":"summary_auto","summarySource":"online","summaryRefKey":"id:1786908294552_2","summaryTargetCharacterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9"}],"gifts":[],"anniversaries":[],"wishes":[],"whispers":[],"qa":[],"isUnlocked":true,"userId":"uid_1780249711141_mu91v1fwe","characterId":"f7477cd4-f197-4657-8a90-75b51a39c8b9","animationShown":true,"storyAchievements":[{"id":"story_1786908294550_8nwv","title":"专属称呼","desc":"确认了情侣身份，并开始讨论彼此的专属亲密称呼。","color":"silver","icon":"heart","date":"2026-08-16T19:24:54.550Z","source":"summary"},{"id":"story_1786987339852_7h2k","title":"专属红黑印记","desc":"换上成对的情头，毫不避讳地宣告彼此的存在","color":"silver","icon":"heart","date":"2026-08-17T17:22:19.852Z","source":"summary"},{"id":"story_1786992571130_3fcd","title":"全盘招供","desc":"坦白所有蓄谋已久的温柔与奔向一辈子的决心","color":"silver","icon":"heart","date":"2026-08-17T18:49:31.130Z","source":"summary"},{"id":"story_1786994849865_9ab5","title":"专属节日承包商","desc":"得知自己是她的初恋后，贺昭驰全额预定了七夕并承诺包办往后所有节日","color":"bronze","icon":"heart","date":"2026-08-17T19:27:29.865Z","source":"summary"}],"qaBank":[{"asker":"npc","question":"还记得第一次见面时的场景吗？当时心里在想什么？","charAnswer":"楼道很暗，电闸很旧。看到她毫无防备的笑，只觉得这姑娘心太大了，想提醒她锁好门。","used":false},{"asker":"npc","question":"恋爱后，有什么因为对方而改变的生活习惯吗？","charAnswer":"以前喝咖啡绝对不加糖。现在去买奶茶，会本能地对店员说“少冰，三分糖”。","used":false},{"asker":"npc","question":"在你们的小家里，宠物和对方谁的地位更高？","charAnswer":"汉堡早就叛变了。现在家里她最大，汉堡第二，我是负责做饭和跑腿的司机。","used":false},{"asker":"npc","question":"对方做过什么让你觉得最安心、最被需要的事情？","charAnswer":"台风天她在高铁站对我说“有你接真好”。那一刻觉得，哪怕拿冠军，也不如平安接她回家踏实。","used":false},{"asker":"npc","question":"收到过对方送的最珍贵的礼物是什么？","charAnswer":"她熬夜画的斯帕雨战图。那是我的27岁生日礼物，现在挂在头盔柜最正中间。","used":false},{"asker":"npc","question":"看到对方和其他异性走得近，真实的内心想法是什么？","charAnswer":"嫉妒得发疯。想把她藏起来，但怕吓到她，只能忍着脾气问她那个男人是谁。","used":false},{"asker":"npc","question":"对你们两人的未来，有什么具体的规划吗？","charAnswer":"谈恋爱就是为了结婚。下了赛道，我只想和她过安稳日子，给她做一辈子番茄排骨汤。","used":false},{"asker":"npc","question":"有什么一直藏在心里，不敢告诉对方的秘密吗？","charAnswer":"怕自己的生理需求会吓跑她。我不是什么正人君子，只是在她面前拼命克制而已。","used":false},{"asker":"char","question":"宝宝，以后画图能不能别总熬夜到凌晨两三点？","charAnswer":"每次看你满桌的冰咖啡我就头疼。你要是再不听话，我就只能把你抱到我床上盯着你睡了。","used":false},{"asker":"char","question":"每次约会你都惦记着汉堡，到底是想见狗还是想见我？","charAnswer":"算了，不跟狗计较。不过下次去吃烤肉，我会把汉堡留在家里，只准你看我。","used":false},{"asker":"char","question":"你的防备心怎么这么低？大半夜遇到停电，随随便便就放陌生男人进屋修电闸？","charAnswer":"还好那个男人是我。以后遇到任何危险，哪怕是半夜，也要第一时间给我打电话，记住了吗？","used":false},{"asker":"char","question":"我公寓的密码0715，你现在应该不会再忘了吧？","charAnswer":"钥匙给你了，密码是我的生日。随时过来查岗，别总觉得我会跑，我这辈子哪儿也不去。","used":false},{"asker":"char","question":"小荔，下次我比赛跑了第一名回来，除了摸奖杯，能不能也抱抱我？","charAnswer":"赛道上再凶，回家也是你的。你理直气壮地使唤我，或者主动抱我，我会觉得很踏实。","used":false}],"qaBankLastRefill":"2026-08-16T19:37:56.501Z"}]